---
layout: base.njk
title: Project
permalink: /project.html
---

<main class="project" id="project">
  <a class="meta project-back" href="/#work">← Back to work</a>
  <h1 id="project-title">Loading project…</h1>
  <div class="meta project-meta" id="project-meta"></div>
  <div class="hero-project" id="project-hero"></div>
  <p class="intro" id="project-description"></p>

  <section class="project-videos" id="project-videos"></section>

  <div class="gallery" id="project-gallery"></div>
  <div class="project-credits" id="project-credits"></div>
</main>

<footer>
  <span>MUBIKISHORE</span>
  <span>© 2026</span>
</footer>

<style>
/* PROJECT HEADER */
.project {
  padding: 55px 22px 70px;
  min-width: 0;
}

.project-back {
  display: inline-block;
  margin-bottom: 28px;
}

.project h1 {
  max-width: 1100px;
  margin: 0;
  font-size: clamp(42px, 7vw, 100px);
  line-height: .94;
  letter-spacing: -.065em;
  font-weight: 500;
  overflow-wrap: anywhere;
}

.project-meta {
  margin-top: 16px;
  line-height: 1.7;
}

.hero-project {
  width: 100%;
  margin-top: 38px;
  background: #0a0a0a;
  overflow: hidden;
}

.hero-project img {
  display: block;
  width: 100%;
  height: auto;
  max-height: 78vh;
  object-fit: contain;
  object-position: center;
  margin: 0 auto;
}

.project .intro {
  max-width: 760px;
  margin: 28px 0 0;
  font-size: clamp(20px, 2.5vw, 32px);
  line-height: 1.25;
  letter-spacing: -.035em;
}

/* VIDEO TITLE LIST */
.project-videos {
  width: 100%;
  margin: 42px 0 0;
  border-top: 1px solid #333;
}

.project-videos-heading {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  padding: 12px 0;
  color: #888;
  font: 10px/1.5 monospace;
  letter-spacing: .1em;
  text-transform: uppercase;
  border-bottom: 1px solid #333;
}

.project-video-item {
  display: block;
  width: 100%;
  min-width: 0;
  color: inherit;
  text-decoration: none;
  border-bottom: 1px solid #333;
}

.project-video-link {
  display: grid;
  grid-template-columns: 46px minmax(0, 1fr) 24px;
  align-items: center;
  gap: 14px;
  width: 100%;
  min-height: 72px;
  padding: 14px 0;
  transition: padding .2s ease;
}

.project-video-number {
  color: #777;
  font: 11px monospace;
  letter-spacing: .05em;
}

.project-video-title {
  min-width: 0;
  margin: 0;
  color: #eee;
  font-size: clamp(17px, 2.2vw, 25px);
  line-height: 1.2;
  font-weight: 400;
  letter-spacing: -.035em;
  overflow-wrap: anywhere;
}

/* EXTERNAL LINK ARROW */
.project-video-arrow {
  justify-self: end;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  color: #888;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 25px;
  font-weight: 300;
  line-height: 1;
  transition: transform .2s ease, color .2s ease;
}

.project-video-arrow::before {
  content: "↗";
  display: block;
  line-height: 1;
  color: inherit;
}

.project-video-item:hover .project-video-link {
  padding-left: 8px;
  padding-right: 8px;
}

.project-video-item:hover .project-video-title,
.project-video-item:hover .project-video-arrow {
  color: #fff;
}

.project-video-item:hover .project-video-arrow {
  transform: translate(2px, -2px);
}

/* IMAGE GALLERY */
.gallery {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  align-items: start;
  gap: 12px;
  margin-top: 44px;
}

.gallery img {
  display: block;
  width: 100%;
  height: auto;
  object-fit: contain;
  background: #151515;
}

.project-credits {
  margin-top: 42px;
  color: #999;
  font: 11px/1.8 monospace;
  white-space: pre-line;
}

/* MOBILE */
@media (max-width: 700px) {
  .project {
    padding: 60px 14px 50px;
  }

  .project-back {
    margin-bottom: 24px;
  }

  .project h1 {
    font-size: clamp(40px, 11vw, 68px);
    line-height: .95;
  }

  .hero-project {
    margin-top: 28px;
  }

  .hero-project img {
    max-height: 65vh;
  }

  .project .intro {
    margin-top: 22px;
  }

  .project-videos {
    margin-top: 30px;
  }

  .project-video-link {
    grid-template-columns: 32px minmax(0, 1fr) 20px;
    gap: 10px;
    min-height: 64px;
    padding: 13px 0;
  }

  .project-video-title {
    font-size: 18px;
  }

  .project-video-arrow {
    width: 20px;
    height: 20px;
    font-size: 23px;
  }

  .project-video-item:hover .project-video-link {
    padding-left: 0;
    padding-right: 0;
  }

  .gallery {
    grid-template-columns: 1fr;
    gap: 10px;
    margin-top: 30px;
  }

  .project-credits {
    margin-top: 30px;
  }
}
</style>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="/admin/config.js"></script>

<script>
(async function () {
  const slug = new URLSearchParams(location.search).get("slug");

  const title = document.getElementById("project-title");
  const meta = document.getElementById("project-meta");
  const hero = document.getElementById("project-hero");
  const description = document.getElementById("project-description");
  const videosContainer = document.getElementById("project-videos");
  const gallery = document.getElementById("project-gallery");
  const credits = document.getElementById("project-credits");

  function safe(value) {
    return String(value ?? "").replace(/[&<>"']/g, char => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;"
    })[char]);
  }

  function normalizeVideos(value) {
    if (typeof value === "string") {
      try {
        value = JSON.parse(value);
      } catch {
        return [];
      }
    }

    if (!Array.isArray(value)) return [];

    return value.map(item => {
      const url = typeof item === "string"
        ? item
        : String(item?.url || "");

      let platform = item && typeof item === "object"
        ? item.platform
        : null;

      if (platform !== "instagram" && platform !== "youtube") {
        try {
          const host = new URL(url).hostname.toLowerCase();

          platform =
            host === "instagram.com" ||
            host.endsWith(".instagram.com")
              ? "instagram"
              : "youtube";
        } catch {
          platform = "youtube";
        }
      }

      return {
        title: typeof item === "string"
          ? ""
          : String(item?.title || ""),
        url,
        platform
      };
    }).filter(item => item.url.trim());
  }

  function validVideoUrl(value) {
    try {
      const url = new URL(value);
      const host = url.hostname.toLowerCase();

      if (url.protocol !== "https:" && url.protocol !== "http:") {
        return false;
      }

      return (
        host === "youtu.be" ||
        host.endsWith(".youtube.com") ||
        host === "youtube.com" ||
        host.endsWith(".instagram.com") ||
        host === "instagram.com"
      );
    } catch {
      return false;
    }
  }

  function makeVideoRow(item, index) {
    const link = document.createElement("a");
    link.className = "project-video-item";
    link.href = item.url;
    link.target = "_blank";
    link.rel = "noopener noreferrer";
    link.setAttribute(
      "aria-label",
      "Open " + (item.title || "video " + (index + 1))
    );

    const row = document.createElement("span");
    row.className = "project-video-link";

    const number = document.createElement("span");
    number.className = "project-video-number";
    number.textContent = String(index + 1).padStart(2, "0");

    const videoTitle = document.createElement("span");
    videoTitle.className = "project-video-title";
    videoTitle.textContent =
      item.title.trim() || "Untitled film";

    const arrow = document.createElement("span");
    arrow.className = "project-video-arrow";
    arrow.setAttribute("aria-hidden", "true");

    row.append(number, videoTitle, arrow);
    link.appendChild(row);

    return link;
  }

  function renderVideos(videos) {
    videosContainer.replaceChildren();

    if (!videos.length) {
      videosContainer.remove();
      return;
    }

    const heading = document.createElement("div");
    heading.className = "project-videos-heading";

    const headingTitle = document.createElement("span");
    headingTitle.textContent = "SELECTED FILMS";

    const count = document.createElement("span");
    count.textContent =
      String(videos.length).padStart(2, "0") + " VIDEOS";

    heading.append(headingTitle, count);
    videosContainer.appendChild(heading);

    videos.forEach((item, index) => {
      videosContainer.appendChild(makeVideoRow(item, index));
    });
  }

  if (!slug) {
    title.textContent = "Project not found";
    return;
  }

  try {
    const { data, error } = await MUBI_SUPABASE
      .from("projects")
      .select("*")
      .eq("slug", slug)
      .eq("published", true)
      .maybeSingle();

    if (error) throw error;

    if (!data) {
      title.textContent = "Project not found";
      return;
    }

    document.title = data.title + " — MUBIKISHORE";
    title.textContent = data.title;
    meta.textContent = [data.date, data.role]
      .filter(Boolean)
      .join(" · ");

    if (data.hero) {
      hero.innerHTML =
        '<img src="' + safe(data.hero) +
        '" alt="' + safe(data.title) + '" loading="eager">';
    } else {
      hero.remove();
    }

    description.textContent = data.description || "";

    if (!data.description) {
      description.remove();
    }

    let videos = normalizeVideos(data.videos);

    // Support projects using the older single-video field.
    if (typeof data.video === "string" && data.video.trim()) {
      const legacyUrl = data.video.trim();

      if (!videos.some(item => item.url.trim() === legacyUrl)) {
        videos.unshift({
          title: "Main Film",
          url: legacyUrl,
          platform: "youtube"
        });
      }
    }

    videos = videos.filter(item => validVideoUrl(item.url));

    renderVideos(videos);

    let images = data.gallery || [];

    if (typeof images === "string") {
      try {
        images = JSON.parse(images);
      } catch {
        images = [];
      }
    }

    if (Array.isArray(images) && images.length) {
      gallery.innerHTML = images.map(item => {
        const src = typeof item === "string"
          ? item
          : item?.image;

        return src
          ? '<img src="' + safe(src) +
            '" alt="' + safe(data.title) +
            '" loading="lazy">'
          : "";
      }).join("");

      if (!gallery.innerHTML.trim()) {
        gallery.remove();
      }
    } else {
      gallery.remove();
    }

    if (data.credits) {
      credits.textContent = data.credits;
    } else {
      credits.remove();
    }

  } catch (error) {
    console.error("Project loading error:", error);
    title.textContent = "Unable to load project";
  }
})();
</script>
