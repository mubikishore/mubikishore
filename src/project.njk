---
layout: base.njk
title: Project
permalink: /project.html
---

<main class="project" id="project">
  <a class="meta" href="/#work">← Back to work</a>
  <h1 id="project-title">Loading project…</h1>
  <div class="meta" id="project-meta"></div>
  <div class="hero-project" id="project-hero"></div>
  <p class="intro" id="project-description"></p>
  <section class="project-videos" id="project-videos"></section>
  <div class="gallery" id="project-gallery"></div>
  <div class="project-credits" id="project-credits"></div>
</main>

<footer>
  <span>MUBIKISHORE</span>
  <span>© 2026</span>
</footer>

<style>
.project-videos {
  margin-top: 40px;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 28px 16px;
  align-items: start;
}

.project-video-item {
  min-width: 0;
  width: 100%;
}

.project-video-frame {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  background: #151515;
  overflow: hidden;
}

.project-video-frame iframe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: 0;
}

.project-video-item.instagram {
  min-width: 0;
}

.project-video-item.instagram blockquote.instagram-media {
  margin: 0 !important;
  width: 100% !important;
  min-width: 0 !important;
  max-width: 400px !important;
}

.project-video-title {
  margin: 12px 0 0;
  font-size: 13px;
  font-weight: 400;
  letter-spacing: .04em;
}

.project-video-link {
  display: inline-block;
  margin-top: 12px;
  font-size: 12px;
}

@media (max-width: 700px) {
  .project-videos {
    grid-template-columns: 1fr;
    gap: 24px;
  }
}
</style>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="/admin/config.js"></script>

<script>
(async function () {
  const slug = new URLSearchParams(location.search).get("slug");

  const title = document.getElementById("project-title");
  const meta = document.getElementById("project-meta");
  const hero = document.getElementById("project-hero");
  const description = document.getElementById("project-description");
  const videosContainer = document.getElementById("project-videos");
  const gallery = document.getElementById("project-gallery");
  const credits = document.getElementById("project-credits");

  function safe(value) {
    return String(value ?? "").replace(/[&<>"']/g, char => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;"
    })[char]);
  }

  function youtubeId(value) {
    try {
      const url = new URL(value);
      const host = url.hostname.toLowerCase();
      let id = "";

      if (host === "youtu.be" || host === "www.youtu.be") {
        id = url.pathname.split("/")[1];
      } else if ([
        "youtube.com",
        "www.youtube.com",
        "m.youtube.com",
        "youtube-nocookie.com",
        "www.youtube-nocookie.com"
      ].includes(host)) {
        if (url.pathname === "/watch") {
          id = url.searchParams.get("v");
        } else if (/^\/(embed|shorts|live)\//.test(url.pathname)) {
          id = url.pathname.split("/")[2];
        }
      }

      return /^[a-zA-Z0-9_-]{11}$/.test(id || "") ? id : null;
    } catch {
      return null;
    }
  }

  function instagramUrl(value) {
    try {
      const url = new URL(value);
      const host = url.hostname.toLowerCase();

      if (
        host !== "instagram.com" &&
        !host.endsWith(".instagram.com")
      ) {
        return null;
      }

      const match = url.pathname.match(
        /^\/(reel|reels|p|tv)\/([A-Za-z0-9_-]+)\/?$/
      );

      if (!match) return null;

      const type = match[1] === "reels" ? "reel" : match[1];

      return "https://www.instagram.com/" +
        type + "/" + match[2] + "/";
    } catch {
      return null;
    }
  }

  function normalizeVideos(value) {
    if (typeof value === "string") {
      try {
        value = JSON.parse(value);
      } catch {
        return [];
      }
    }

    if (!Array.isArray(value)) return [];

    return value.map(item => {
      const url = typeof item === "string"
        ? item
        : String(item?.url || "");

      let platform = typeof item === "object" && item
        ? item.platform
        : null;

      // Detect the platform from the URL if not saved.
      if (platform !== "instagram" && platform !== "youtube") {
        try {
          const host = new URL(url).hostname.toLowerCase();

          platform =
            host === "instagram.com" ||
            host.endsWith(".instagram.com")
              ? "instagram"
              : "youtube";
        } catch {
          platform = "youtube";
        }
      }

      return {
        title: typeof item === "string"
          ? ""
          : String(item?.title || ""),
        url,
        platform
      };
    }).filter(item => item.url.trim());
  }

  function makeVideo(item, index) {
    const wrapper = document.createElement("article");
    wrapper.className = "project-video-item";

    let embedUrl = null;

    if (item.platform === "instagram") {
      embedUrl = instagramUrl(item.url);
      wrapper.classList.add("instagram");
    } else {
      const id = youtubeId(item.url);

      if (id) {
        embedUrl = "https://www.youtube-nocookie.com/embed/" + id;
      }
    }

    if (embedUrl && item.platform === "instagram") {
      // Do not force Instagram into a fixed-height frame.
      // Instagram controls the rendered embed dimensions.
      const blockquote = document.createElement("blockquote");
      blockquote.className = "instagram-media";
      blockquote.setAttribute("data-instgrm-permalink", embedUrl);
      blockquote.setAttribute("data-instgrm-version", "14");
      blockquote.style.cssText =
        "margin:0;width:100%;max-width:400px;";

      const fallback = document.createElement("a");
      fallback.href = embedUrl;
      fallback.target = "_blank";
      fallback.rel = "noopener noreferrer";
      fallback.textContent = "View Reel on Instagram ↗";

      blockquote.appendChild(fallback);
      wrapper.appendChild(blockquote);

    } else if (embedUrl) {
      const frame = document.createElement("div");
      frame.className = "project-video-frame";

      const iframe = document.createElement("iframe");
      iframe.src = embedUrl;
      iframe.title = item.title ||
        (title.textContent + " video " + (index + 1));
      iframe.loading = "lazy";
      iframe.allow =
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      iframe.referrerPolicy = "strict-origin-when-cross-origin";
      iframe.allowFullscreen = true;

      frame.appendChild(iframe);
      wrapper.appendChild(frame);

    } else {
      const link = document.createElement("a");
      link.className = "project-video-link";
      link.href = item.url;
      link.target = "_blank";
      link.rel = "noopener noreferrer";
      link.textContent = item.platform === "instagram"
        ? "VIEW REEL ON INSTAGRAM ↗"
        : "WATCH VIDEO ↗";

      wrapper.appendChild(link);
    }

    if (item.title.trim()) {
      const caption = document.createElement("h2");
      caption.className = "project-video-title";
      caption.textContent = item.title;
      wrapper.appendChild(caption);
    }

    return wrapper;
  }

  function loadInstagramScript() {
    if (window.instgrm?.Embeds) {
      window.instgrm.Embeds.process();
      return;
    }

    if (document.getElementById("instagram-embed-script")) return;

    const script = document.createElement("script");
    script.id = "instagram-embed-script";
    script.src = "https://www.instagram.com/embed.js";
    script.async = true;
    script.onload = () => {
      window.instgrm?.Embeds?.process();
    };

    document.body.appendChild(script);
  }

  if (!slug) {
    title.textContent = "Project not found";
    return;
  }

  try {
    const { data, error } = await MUBI_SUPABASE
      .from("projects")
      .select("*")
      .eq("slug", slug)
      .eq("published", true)
      .maybeSingle();

    if (error) throw error;

    if (!data) {
      title.textContent = "Project not found";
      return;
    }

    document.title = data.title + " — MUBIKISHORE";
    title.textContent = data.title;
    meta.textContent = [data.date, data.role]
      .filter(Boolean)
      .join(" · ");

    if (data.hero) {
      hero.innerHTML =
        '<img src="' + safe(data.hero) +
        '" alt="' + safe(data.title) + '" loading="eager">';
    } else {
      hero.remove();
    }

    description.textContent = data.description || "";

    if (!data.description) {
      description.remove();
    }

    let videos = normalizeVideos(data.videos);

    // Support the older single-video field as well.
    if (data.video && data.video.trim()) {
      const legacyUrl = data.video.trim();

      if (!videos.some(item => item.url.trim() === legacyUrl)) {
        let platform = "youtube";

        try {
          const host = new URL(legacyUrl).hostname.toLowerCase();

          if (
            host === "instagram.com" ||
            host.endsWith(".instagram.com")
          ) {
            platform = "instagram";
          }
        } catch {}

        videos.unshift({
          title: "Main Film",
          url: legacyUrl,
          platform
        });
      }
    }

    if (videos.length) {
      videosContainer.replaceChildren();

      // Every video goes into the same two-column grid.
      videos.forEach((item, index) => {
        videosContainer.appendChild(makeVideo(item, index));
      });

      if (videos.some(item => item.platform === "instagram")) {
        loadInstagramScript();
      }
    } else {
      videosContainer.remove();
    }

    let images = data.gallery || [];

    if (typeof images === "string") {
      try {
        images = JSON.parse(images);
      } catch {
        images = [];
      }
    }

    if (Array.isArray(images) && images.length) {
      gallery.innerHTML = images.map(item => {
        const src = typeof item === "string" ? item : item.image;

        return src
          ? '<img src="' + safe(src) +
            '" alt="' + safe(data.title) + '" loading="lazy">'
          : "";
      }).join("");
    } else {
      gallery.remove();
    }

    if (data.credits) {
      credits.textContent = data.credits;
    } else {
      credits.remove();
    }

  } catch (error) {
    console.error("Project loading error:", error);
    title.textContent = "Unable to load project";
  }
})();
</script>
