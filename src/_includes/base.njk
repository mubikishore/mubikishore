
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ title or site.name }}</title>

  <style>
    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background: #0a0a0a;
      color: #f1f0ec;
      font: 14px Arial, sans-serif;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      padding: 18px 22px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 20;
      mix-blend-mode: difference;
    }

    .brand {
      font-weight: 600;
    }

    nav {
      display: flex;
      gap: 20px;
      text-transform: uppercase;
      font: 12px monospace;
    }

    nav a:hover {
      opacity: .6;
    }

    /* HOMEPAGE HERO */

    .hero {
      min-height: 100vh;
      padding: 120px 22px 24px;
      display: flex;
      flex-direction: column;
    }

    .hero-box {
      position: relative;
      flex: 1;
      min-height: 75vh;
      border: 1px solid #292929;
      display: flex;
      align-items: center;
      justify-content: center;
      background: radial-gradient(circle, #292929, #0a0a0a);
      overflow: hidden;
      isolation: isolate;
    }

    .hero-copy {
      position: relative;
      z-index: 2;
      width: 100%;
      text-align: center;
      padding: 35px 16px;
    }

    .eyebrow,
    .meta,
    .ph {
      font: 11px monospace;
      color: #999;
      text-transform: uppercase;
    }

    .hero h1 {
      position: relative;
      z-index: 3;
      font-size: clamp(50px, 10vw, 140px);
      line-height: .8;
      letter-spacing: -.08em;
      font-weight: 500;
      margin: 70px 0;
    }

    .hero-media {
      position: relative;
      z-index: 1;
      width: 100%;
      height: min(55vh, 650px);
      overflow: hidden;
      background: #151515;
    }

    .hero-media video {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }

    .hero-media .ph {
      display: block;
      padding: 20px;
    }

    .hero-meta {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      padding-top: 14px;
    }

    /* GENERAL SECTIONS */

    .section {
      padding: 110px 22px 70px;
      scroll-margin-top: 60px;
    }

    .head {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      border-bottom: 1px solid #292929;
      padding-bottom: 12px;
      margin-bottom: 28px;
      font: 12px monospace;
      text-transform: uppercase;
    }

    .intro {
      font-size: clamp(28px, 4vw, 58px);
      max-width: 850px;
      letter-spacing: -.05em;
    }

    /* SELECTED WORK */

    .work {
      border: 1px solid #292929;
    }

    .row {
      display: grid;
      grid-template-columns: 90px minmax(0, 1fr) 180px 25px;
      align-items: center;
      gap: 10px;
      padding: 17px 14px;
      border-bottom: 1px solid #292929;
      transition: background .2s ease;
    }

    .row:last-child {
      border-bottom: 0;
    }

    .row:hover {
      background: #151515;
    }

    .title {
      font-size: clamp(18px, 2.2vw, 29px);
    }

    .meta {
      color: #777;
    }

    /* GRIDS */

    .grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1px;
      background: #292929;
    }

    .tile {
      position: relative;
      aspect-ratio: 1;
      min-width: 0;
      background: #151515;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .tile img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* STORE */

    .grid.store {
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 380px));
      gap: 14px;
      align-items: start;
      background: transparent;
    }

    .store .product {
      display: block;
      width: 100%;
      min-width: 0;
      align-self: start;
      background: #121212;
      border: 1px solid #292929;
      transition: border-color .25s ease, transform .25s ease;
    }

    .store a.product:hover {
      border-color: #777;
      transform: translateY(-3px);
    }

    .product-img {
      width: 100%;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #191919;
    }

    .product-img img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .product-info {
      padding: 16px;
    }

    .product-info .title {
      font-size: 24px;
      line-height: 1.15;
    }

    .product-info .meta {
      margin-top: 8px;
      line-height: 1.5;
    }

    .product-link-label {
      display: inline-block;
      margin-top: 14px;
      font: 11px monospace;
      text-transform: uppercase;
      color: #aaa;
    }

    /* ABOUT */

    .about {
      display: grid;
      grid-template-columns: 1.4fr .6fr;
      gap: 60px;
      border-top: 1px solid #292929;
      padding-top: 25px;
    }

    .about-copy {
      font-size: clamp(24px, 3vw, 42px);
      letter-spacing: -.04em;
    }

    .about-side {
      font: 11px monospace;
      color: #999;
      text-transform: uppercase;
      line-height: 1.8;
      overflow-wrap: anywhere;
    }

    footer {
      padding: 90px 22px 24px;
      border-top: 1px solid #292929;
      display: flex;
      justify-content: space-between;
      font: 11px monospace;
    }

    /* PROJECT PAGE */

    .project {
      padding: 130px 22px 70px;
      min-width: 0;
    }

    .project h1 {
      font-size: clamp(50px, 10vw, 150px);
      line-height: .8;
      letter-spacing: -.08em;
      font-weight: 500;
      overflow-wrap: anywhere;
    }

    .hero-project {
      width: 100%;
      min-width: 0;
      min-height: 0;
      height: auto;
      margin-top: 50px;
      border: 0;
      display: block;
      background: #0a0a0a;
      overflow: hidden;
    }

    .hero-project img {
      display: block;
      width: 100%;
      height: auto;
      max-height: 85vh;
      object-fit: contain;
      object-position: center;
      margin: 0 auto;
    }

    .gallery {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
      gap: 12px;
      background: transparent;
      margin-top: 50px;
    }

    .gallery img {
      display: block;
      width: 100%;
      height: auto;
      object-fit: contain;
      background: #151515;
    }

    .video-link {
      margin-top: 30px;
      font: 12px monospace;
      text-transform: uppercase;
    }

    .project-credits {
      margin-top: 50px;
      color: #999;
      font: 12px monospace;
      white-space: pre-line;
    }

    /* MOBILE */

    @media (max-width: 700px) {
      header {
        padding: 14px;
      }

      nav {
        gap: 10px;
        font-size: 10px;
      }

      .hero {
        min-height: 100svh;
        padding: 90px 14px 14px;
      }

      .hero-box {
        min-height: 70vh;
      }

      .hero-copy {
        padding: 25px 10px;
      }

      .hero h1 {
        font-size: clamp(48px, 12vw, 90px);
        margin: 45px 0;
      }

      .hero-media {
        height: 40vh;
      }

      .hero-meta {
        flex-wrap: wrap;
        gap: 8px 16px;
      }

      .section,
      .project {
        padding-left: 14px;
        padding-right: 14px;
      }

      .row {
        grid-template-columns: 45px minmax(0, 1fr) 20px;
        gap: 8px;
      }

      .row .date {
        display: none;
      }

      .grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .grid.store {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
      }

      .product-info {
        padding: 12px;
      }

      .product-info .title {
        font-size: 19px;
      }

      .about {
        grid-template-columns: 1fr;
        gap: 28px;
      }

      .hero-project {
        margin-top: 30px;
      }

      .hero-project img {
        max-height: 70vh;
      }

      .gallery {
        grid-template-columns: 1fr;
        gap: 10px;
      }

      footer {
        padding: 60px 14px 24px;
      }
    }

    @media (max-width: 380px) {
      nav {
        gap: 7px;
        font-size: 9px;
      }

      .grid.store {
        grid-template-columns: minmax(0, 1fr);
      }

      .head {
        font-size: 10px;
      }
    }
  </style>

  <script>
    if (
      /(invite|recovery|confirmation|email_change)_token=/.test(location.hash)
      && !location.pathname.startsWith("/admin")
    ) {
      location.replace("/admin/" + location.hash);
    }
  </script>
</head>

<body>
  <header>
    <a class="brand" href="/">MUBIKISHORE</a>

    <nav>
      <a href="/#work">Work</a>
      <a href="/#store">Store</a>
      <a href="/#other">Other</a>
      <a href="/#about">About</a>
    </nav>
  </header>

  {{content|safe}}
</body>
</html>
