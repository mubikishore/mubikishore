---
title: MUBIKISHORE
layout: base.njk
---

<section class="hero">
  <div class="hero-box" id="hero-box">
    <div class="hero-video-layer" id="hero-media">
      <span class="ph">[ hero still / reel ]</span>
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-copy">
      <div class="eyebrow">{{site.tagline}}</div>
      <h1>MUBI<br>KISHORE</h1>
    </div>
  </div>
  <div class="hero-meta meta">
    <span>{{site.location}}</span>
    <span>Selected works · 2024—2026</span>
    <span>Scroll ↓</span>
  </div>
</section>

<section class="section" id="work">
  <div class="head">
    <span>01 / Selected Work</span>
    <span id="project-count">Loading…</span>
  </div>
  <p class="intro">Films, collaborations, experiments and things made along the way.</p>
  <div class="work" id="cms-projects">
    <div class="row">
      <span class="meta">—</span>
      <span class="title">Loading projects…</span>
      <span class="meta date"></span>
      <span>→</span>
    </div>
  </div>
</section>

<section class="section" id="store">
  <div class="head">
    <span>02 / Store</span>
    <span>Objects / prints / editions</span>
  </div>
  <div class="grid store" id="cms-products">
    <p class="meta">Loading products…</p>
  </div>
</section>

<section class="section" id="other">
  <div class="head">
    <span>03 / Other Things</span>
    <span>35mm / BTS / photography / tests</span>
  </div>
  <div class="grid" id="cms-other">
    <p class="meta">Loading other content…</p>
  </div>
</section>

<!-- OTHER CONTENT PHOTO VIEWER -->
<div class="other-viewer" id="other-viewer" role="dialog" aria-modal="true" aria-label="Photo preview" hidden>
  <button class="other-viewer-close" id="other-viewer-close" type="button" aria-label="Close preview">×</button>
  <button class="other-viewer-arrow other-viewer-prev" id="other-viewer-prev" type="button" aria-label="Previous photo">←</button>

  <div class="other-viewer-stage">
    <article class="other-print">
      <div class="other-print-image">
        <img id="other-viewer-image" alt="">
      </div>
      <div class="other-print-caption">
        <div class="other-print-type" id="other-viewer-type"></div>
        <h2 id="other-viewer-title"></h2>
        <p id="other-viewer-caption"></p>
        <a id="other-viewer-link" href="#" target="_blank" rel="noopener noreferrer" hidden>OPEN LINK ↗</a>
      </div>
    </article>
    <div class="other-viewer-count" id="other-viewer-count"></div>
  </div>

  <button class="other-viewer-arrow other-viewer-next" id="other-viewer-next" type="button" aria-label="Next photo">→</button>
</div>

<section class="section" id="about">
  <div class="head">
    <span>04 / About</span>
    <span>Words later</span>
  </div>
  <div class="about">
    <div class="about-copy">{{site.about}}</div>
    <div class="about-side">
      {{site.location}}<br><br>
      Available for films / collaborations / commercial work<br><br>
      {{site.instagram}}<br>
      {{site.email}}
    </div>
  </div>
</section>

<footer>
  <span>MUBIKISHORE</span>
  <span>© 2026</span>
</footer>

<style>
/* HERO */
.hero {
  min-height: 700px;
  padding-top: 45px;
  padding-bottom: 16px;
}

.hero-box {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  height: 62vh;
  min-height: 420px;
  max-height: 720px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #111;
}

.hero-video-layer {
  position: absolute;
  inset: 0;
  z-index: -2;
  overflow: hidden;
  background: radial-gradient(circle, #292929, #0a0a0a);
}

.hero-video-layer video,
.hero-video-layer img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 45%;
}

.hero-overlay {
  position: absolute;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background: linear-gradient(
    180deg,
    rgba(0,0,0,.18) 0%,
    rgba(0,0,0,.08) 45%,
    rgba(0,0,0,.38) 100%
  );
}

.hero-copy {
  position: relative;
  z-index: 1;
  width: 100%;
  padding: 55px 16px;
  text-align: center;
  pointer-events: none;
}

.hero-copy .eyebrow {
  margin-bottom: 45px;
  color: #f1f0ec;
  text-shadow: 0 1px 12px rgba(0,0,0,.45);
}

.hero-copy h1 {
  margin: 0;
  color: #f1f0ec;
  font-size: clamp(64px, 12vw, 160px);
  line-height: .78;
  letter-spacing: -.085em;
  font-weight: 500;
  text-shadow: 0 2px 24px rgba(0,0,0,.16);
}

.hero-meta {
  gap: 12px;
}

/* CLICKABLE OTHER PHOTOS */
#cms-other .other-tile {
  appearance: none;
  position: relative;
  display: block;
  width: 100%;
  min-width: 0;
  padding: 0;
  border: 0;
  overflow: hidden;
  color: inherit;
  font: inherit;
  text-align: left;
  cursor: zoom-in;
  background: #242424;
}

#cms-other .other-tile img {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .45s ease;
}

#cms-other .other-tile:hover img {
  transform: scale(1.035);
}

#cms-other .other-tile:focus-visible {
  outline: 2px solid white;
  outline-offset: 4px;
}

.other-tile-caption {
  position: absolute;
  inset: auto 0 0;
  z-index: 1;
  display: block;
  padding: 34px 12px 12px;
  color: #fff;
  background: linear-gradient(transparent, rgba(0,0,0,.82));
  pointer-events: none;
}

.other-tile-title {
  display: block;
  font-size: 14px;
}

.other-tile-caption .meta {
  display: block;
  margin-top: 5px;
  color: rgba(255,255,255,.72);
  font-size: 10px;
  line-height: 1.4;
  text-transform: none;
}

/* POLAROID VIEWER */
body.other-viewer-open {
  overflow: hidden;
}

.other-viewer[hidden] {
  display: none !important;
}

.other-viewer {
  position: fixed;
  inset: 0;
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 56px 82px 34px;
  background: rgba(5,5,5,.95);
  backdrop-filter: blur(7px);
  -webkit-backdrop-filter: blur(7px);
}

.other-viewer-stage {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 15px;
  max-width: 100%;
  max-height: 100%;
}

.other-print {
  max-width: 100%;
  padding: 11px 11px 0;
  background: #f1f0ec;
  color: #111;
  box-shadow: 0 18px 70px rgba(0,0,0,.45);
  transform: rotate(-.25deg);
}

.other-print-image {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #171717;
}

.other-print-image img {
  display: block;
  width: auto;
  height: auto;
  max-width: min(76vw, 1050px);
  max-height: 62vh;
  object-fit: contain;
}

.other-print-caption {
  padding: 17px 8px 21px;
}

.other-print-type {
  margin-bottom: 8px;
  color: #777;
  font: 10px monospace;
  text-transform: uppercase;
  letter-spacing: .08em;
}

.other-print-caption h2 {
  margin: 0;
  font-size: clamp(20px, 3vw, 32px);
  line-height: 1.08;
  font-weight: 500;
  letter-spacing: -.04em;
}

.other-print-caption p {
  margin: 9px 0 0;
  max-width: 680px;
  color: #555;
  font-size: 13px;
  line-height: 1.5;
  white-space: pre-line;
}

.other-print-caption p:empty {
  display: none;
}

.other-print-caption a {
  display: inline-block;
  margin-top: 13px;
  color: #222;
  font: 10px monospace;
  text-underline-offset: 3px;
}

.other-viewer-count {
  color: #aaa;
  font: 11px monospace;
  letter-spacing: .08em;
}

.other-viewer-close,
.other-viewer-arrow {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border: 1px solid rgba(255,255,255,.3);
  border-radius: 50%;
  color: #f1f0ec;
  background: rgba(20,20,20,.75);
  font: 24px Arial,sans-serif;
  cursor: pointer;
}

.other-viewer-close {
  top: 22px;
  right: 24px;
  font-size: 30px;
}

.other-viewer-prev {
  left: 22px;
}

.other-viewer-next {
  right: 22px;
}

.other-viewer-close:hover,
.other-viewer-arrow:hover {
  background: #292929;
  border-color: #888;
}

/* MOBILE */
@media (max-width: 700px) {
  .hero-box {
    min-height: 70vh;
  }

  .hero-copy {
    padding: 40px 10px;
  }

  .hero-copy .eyebrow {
    margin-bottom: 35px;
    font-size: 10px;
  }

  .hero-copy h1 {
    font-size: clamp(56px, 13vw, 100px);
  }

  .hero-meta {
    font-size: 9px;
  }

  .other-viewer {
    padding: 58px 12px 72px;
  }

  .other-print {
    padding: 8px 8px 0;
  }

  .other-print-image img {
    max-width: calc(100vw - 44px);
    max-height: 60vh;
  }

  .other-print-caption {
    padding: 13px 6px 17px;
  }

  .other-viewer-close {
    top: 11px;
    right: 12px;
    width: 38px;
    height: 38px;
  }

  .other-viewer-arrow {
    top: auto;
    bottom: 17px;
    width: 42px;
    height: 42px;
  }

  .other-viewer-prev {
    left: calc(50% - 52px);
  }

  .other-viewer-next {
    right: calc(50% - 52px);
  }
}
</style>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="/admin/config.js"></script>

<script>
(async function () {
  const db = window.MUBI_SUPABASE;

  const escapeHtml = value => String(value ?? "")
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");

  function safeUrl(value) {
    if (!value) return "";
    try {
      const url = new URL(value, location.origin);
      return ["https:", "http:"].includes(url.protocol) ? url.href : "";
    } catch {
      return "";
    }
  }

  function showSectionError(id, message) {
    const element = document.getElementById(id);
    if (element) {
      element.innerHTML = `<p class="meta">${escapeHtml(message)}</p>`;
    }
  }

  if (!db) {
    document.getElementById("project-count").textContent = "Database unavailable";
    showSectionError("cms-projects", "Could not connect to the content database.");
    showSectionError("cms-products", "Could not connect to the content database.");
    showSectionError("cms-other", "Could not connect to the content database.");
    return;
  }

  // SELECTED WORK
  try {
    const { data, error } = await db
      .from("projects")
      .select("title, slug, date, year, published")
      .eq("published", true)
      .order("date", { ascending: false, nullsFirst: false });

    if (error) throw error;

    const projects = data || [];
    document.getElementById("project-count").textContent =
      `${projects.length} projects`;

    document.getElementById("cms-projects").innerHTML = projects.length
      ? projects.map(project => {
          const date = project.date
            ? new Date(project.date + "T00:00:00").toLocaleDateString("en-GB", {
                day: "numeric",
                month: "long",
                year: "numeric"
              })
            : "";

          return `
            <a class="row" href="/project.html?slug=${encodeURIComponent(project.slug || "")}">
              <span class="meta">${escapeHtml(project.year || "")}</span>
              <span class="title">${escapeHtml(project.title || "Untitled project")}</span>
              <span class="meta date">${escapeHtml(date)}</span>
              <span>→</span>
            </a>`;
        }).join("")
      : `<div class="row">
          <span class="meta">—</span>
          <span class="title">No published projects yet.</span>
          <span></span><span>→</span>
        </div>`;
  } catch (error) {
    console.error("Projects:", error);
    document.getElementById("project-count").textContent = "Projects unavailable";
    showSectionError("cms-projects", "Could not load projects.");
  }

  // STORE PRODUCTS
  try {
    const { data, error } = await db
      .from("products")
      .select("*")
      .eq("published", true)
      .order("created_at", { ascending: false });

    if (error) throw error;

    const products = data || [];
    const container = document.getElementById("cms-products");

    container.innerHTML = products.length
      ? products.map(product => {
          const image = safeUrl(product.image);
          const link = safeUrl(product.link_url);

          const content = `
            <div class="product-img">
              ${image
                ? `<img src="${escapeHtml(image)}" alt="${escapeHtml(product.title || "")}" loading="lazy">`
                : `<span class="ph">[ product image ]</span>`}
            </div>
            <div class="product-info">
              <div class="title">${escapeHtml(product.title || "Untitled product")}</div>
              ${product.description
                ? `<p class="meta">${escapeHtml(product.description)}</p>`
                : ""}
              ${product.price
                ? `<div class="meta">${escapeHtml(product.price)}</div>`
                : ""}
              ${link ? `<span class="product-link-label">View item ↗</span>` : ""}
            </div>`;

          return link
            ? `<a class="product" href="${escapeHtml(link)}" target="_blank" rel="noopener noreferrer">${content}</a>`
            : `<article class="product">${content}</article>`;
        }).join("")
      : '<p class="meta">No published products yet.</p>';
  } catch (error) {
    console.error("Products:", error);
    showSectionError("cms-products", "Products could not be loaded.");
  }

  // OTHER CONTENT + POLAROID VIEWER
  try {
    const { data, error } = await db
      .from("other_content")
      .select("*")
      .eq("published", true)
      .order("created_at", { ascending: false });

    if (error) throw error;

    const items = data || [];
    const container = document.getElementById("cms-other");
    const viewer = document.getElementById("other-viewer");
    const viewerImage = document.getElementById("other-viewer-image");
    const viewerTitle = document.getElementById("other-viewer-title");
    const viewerCaption = document.getElementById("other-viewer-caption");
    const viewerType = document.getElementById("other-viewer-type");
    const viewerCount = document.getElementById("other-viewer-count");
    const viewerLink = document.getElementById("other-viewer-link");
    const closeButton = document.getElementById("other-viewer-close");
    let activeIndex = 0;
    let previousFocus = null;

    container.innerHTML = items.length
      ? items.map((item, index) => {
          const image = safeUrl(item.image);
          return `
            <button class="tile other-tile" type="button" data-other-index="${index}" aria-label="Preview ${escapeHtml(item.title || "photograph")}">
              ${image
                ? `<img src="${escapeHtml(image)}" alt="${escapeHtml(item.title || "")}" loading="lazy">`
                : `<span class="ph">${escapeHtml(item.type || "Photography")}</span>`}
              <span class="other-tile-caption">
                <span class="other-tile-title">${escapeHtml(item.title || "Untitled")}</span>
                ${item.caption ? `<span class="meta">${escapeHtml(item.caption)}</span>` : ""}
              </span>
            </button>`;
        }).join("")
      : '<p class="meta">No published content yet.</p>';

    function renderItem(index) {
      if (!items.length) return;

      activeIndex = (index + items.length) % items.length;
      const item = items[activeIndex];
      const image = safeUrl(item.image);
      const link = safeUrl(item.link_url);

      viewerImage.src = image || "";
      viewerImage.alt = item.title || "Photography";
      viewerImage.parentElement.hidden = !image;
      viewerTitle.textContent = item.title || "Untitled";
      viewerCaption.textContent = item.caption || "";
      viewerType.textContent = item.type || "Photography";
      viewerCount.textContent =
        `${String(activeIndex + 1).padStart(2, "0")} / ${String(items.length).padStart(2, "0")}`;

      viewerLink.href = link || "#";
      viewerLink.hidden = !link;
    }

    function openViewer(index) {
      previousFocus = document.activeElement;
      renderItem(index);
      viewer.hidden = false;
      document.body.classList.add("other-viewer-open");
      closeButton.focus();
    }

    function closeViewer() {
      viewer.hidden = true;
      document.body.classList.remove("other-viewer-open");

      if (previousFocus && typeof previousFocus.focus === "function") {
        previousFocus.focus();
      }
    }

    container.addEventListener("click", event => {
      const tile = event.target.closest("[data-other-index]");
      if (tile) openViewer(Number(tile.dataset.otherIndex));
    });

    closeButton.addEventListener("click", closeViewer);

    document.getElementById("other-viewer-prev").addEventListener("click", () => {
      renderItem(activeIndex - 1);
    });

    document.getElementById("other-viewer-next").addEventListener("click", () => {
      renderItem(activeIndex + 1);
    });

    viewer.addEventListener("click", event => {
      if (event.target === viewer) closeViewer();
    });

    document.addEventListener("keydown", event => {
      if (viewer.hidden) return;
      if (event.key === "Escape") closeViewer();
      if (event.key === "ArrowLeft") renderItem(activeIndex - 1);
      if (event.key === "ArrowRight") renderItem(activeIndex + 1);
    });
  } catch (error) {
    console.error("Other content:", error);
    showSectionError("cms-other", "Other content could not be loaded.");
  }

  // HOMEPAGE HERO REEL
  try {
    const { data, error } = await db
      .from("site_settings")
      .select("hero_video, hero_poster, hero_autoplay, hero_muted, hero_loop")
      .order("id", { ascending: true })
      .limit(1);

    if (error) throw error;

    const settings = data && data[0];
    const hero = document.getElementById("hero-media");

    if (settings && settings.hero_video && hero) {
      const videoUrl = safeUrl(settings.hero_video);

      if (!videoUrl) throw new Error("The hero video URL is invalid.");

      const video = document.createElement("video");
      video.src = videoUrl;
      video.autoplay = settings.hero_autoplay !== false;
      video.muted = settings.hero_muted !== false;
      video.loop = settings.hero_loop !== false;
      video.playsInline = true;
      video.controls = false;
      video.preload = "metadata";

      const posterUrl = safeUrl(settings.hero_poster);
      if (posterUrl) video.poster = posterUrl;

      hero.replaceChildren(video);

      if (video.autoplay) {
        video.play().catch(error => {
          console.warn("Hero autoplay was blocked:", error);
        });
      }
    }
  } catch (error) {
    console.error("Hero reel:", error);
  }
})();
</script>
