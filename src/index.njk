---
title: MUBIKISHORE
layout: base.njk
---

<section class="hero">
  <div class="hero-box" id="hero-box">
    <div class="hero-video-layer" id="hero-media">
      <span class="ph">[ hero still / reel ]</span>
    </div>
    <div class="hero-overlay"></div>

    <div class="hero-copy">
      <div class="eyebrow">{{site.tagline}}</div>
      <h1>MUBI<br>KISHORE</h1>
    </div>
  </div>

  <div class="hero-meta meta">
    <span>{{site.location}}</span>
    <span>Selected works · 2024—2026</span>
    <span>Scroll ↓</span>
  </div>
</section>

<section class="section" id="work">
  <div class="head">
    <span>01 / Selected Work</span>
    <span id="project-count">Loading…</span>
  </div>

  <p class="intro">Films, collaborations, experiments and things made along the way.</p>

  <div class="work" id="cms-projects">
    <div class="row">
      <span class="meta">—</span>
      <span class="title">Loading projects…</span>
      <span class="meta date"></span>
      <span>→</span>
    </div>
  </div>
</section>

<section class="section" id="store">
  <div class="head">
    <span>02 / Store</span>
    <span>Objects / prints / editions</span>
  </div>

  <div class="grid store" id="cms-products">
    <p class="meta">Loading products…</p>
  </div>
</section>

<section class="section" id="other">
  <div class="head">
    <span>03 / Other Things</span>
    <span>35mm / BTS / photography / tests</span>
  </div>

  <div class="grid" id="cms-other">
    <p class="meta">Loading other content…</p>
  </div>
</section>

<section class="section" id="about">
  <div class="head">
    <span>04 / About</span>
    <span>Words later</span>
  </div>

  <div class="about">
    <div class="about-copy">{{site.about}}</div>
    <div class="about-side">
      {{site.location}}<br><br>
      Available for films / collaborations / commercial work<br><br>
      {{site.instagram}}<br>
      {{site.email}}
    </div>
  </div>
</section>

<footer>
  <span>MUBIKISHORE</span>
  <span>© 2026</span>
</footer>

<style>
  /* HERO: VIDEO BACKGROUND */
  .hero {
    min-height: auto;
    padding-top: 100px;
    padding-bottom: 16px;
  }

  .hero-box {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    height: 62vh;
    min-height: 420px;
    max-height: 720px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #111;
  }

  .hero-video-layer {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    background: radial-gradient(circle, #292929, #0a0a0a);
  }

  .hero-video-layer video,
  .hero-video-layer img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, .18) 0%,
      rgba(0, 0, 0, .08) 45%,
      rgba(0, 0, 0, .38) 100%
    );
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 45px 16px;
    text-align: center;
    pointer-events: none;
  }

  .hero-copy .eyebrow {
    margin-bottom: 38px;
    color: #f1f0ec;
    text-shadow: 0 1px 12px rgba(0, 0, 0, .45);
  }

  .hero-copy h1 {
    margin: 0;
    color: #f1f0ec;
    font-size: clamp(64px, 12vw, 160px);
    line-height: .78;
    letter-spacing: -.085em;
    font-weight: 500;
    text-shadow: 0 2px 24px rgba(0, 0, 0, .16);
  }

  .hero-meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-top: 12px;
  }

  /* RESPONSIVE */
  @media (max-width: 700px) {
    .hero {
      padding-top: 82px;
      padding-bottom: 12px;
    }

    .hero-box {
      height: 58vh;
      min-height: 360px;
      max-height: 600px;
    }

    .hero-copy {
      padding: 35px 10px;
    }

    .hero-copy .eyebrow {
      margin-bottom: 30px;
      font-size: 10px;
    }

    .hero-copy h1 {
      font-size: clamp(56px, 13vw, 100px);
    }

    .hero-meta {
      font-size: 9px;
      gap: 6px;
    }
  }

  @media (max-width: 380px) {
    .hero-box {
      height: 55vh;
      min-height: 320px;
    }

    .hero-meta {
      font-size: 8px;
    }
  }
</style>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="/admin/config.js"></script>

<script>
(async function () {
  const db = window.MUBI_SUPABASE;

  const escapeHtml = value => String(value ?? "")
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");

  function safeUrl(value) {
    if (!value) return "";

    try {
      const url = new URL(value, location.origin);

      return ["https:", "http:"].includes(url.protocol)
        ? url.href
        : "";
    } catch {
      return "";
    }
  }

  function showSectionError(id, message) {
    const element = document.getElementById(id);

    if (element) {
      element.innerHTML =
        `<p class="meta">${escapeHtml(message)}</p>`;
    }
  }

  if (!db) {
    document.getElementById("project-count").textContent =
      "Database unavailable";

    showSectionError("cms-projects", "Could not connect to the content database.");
    showSectionError("cms-products", "Could not connect to the content database.");
    showSectionError("cms-other", "Could not connect to the content database.");

    return;
  }

  // SELECTED WORK
  try {
    const { data, error } = await db
      .from("projects")
      .select("title, slug, date, year, published")
      .eq("published", true)
      .order("date", { ascending: false, nullsFirst: false });

    if (error) throw error;

    const projects = data || [];

    document.getElementById("project-count").textContent =
      `${projects.length} projects`;

    document.getElementById("cms-projects").innerHTML = projects.length
      ? projects.map(project => {
          const date = project.date
            ? new Date(project.date + "T00:00:00")
                .toLocaleDateString("en-GB", {
                  day: "numeric",
                  month: "long",
                  year: "numeric"
                })
            : "";

          return `
            <a class="row" href="/project.html?slug=${encodeURIComponent(project.slug || "")}">
              <span class="meta">${escapeHtml(project.year || "")}</span>
              <span class="title">${escapeHtml(project.title || "Untitled project")}</span>
              <span class="meta date">${escapeHtml(date)}</span>
              <span>→</span>
            </a>`;
        }).join("")
      : `<div class="row">
          <span class="meta">—</span>
          <span class="title">No published projects yet.</span>
          <span></span>
          <span>→</span>
        </div>`;

  } catch (error) {
    console.error("Projects:", error);

    document.getElementById("project-count").textContent =
      "Projects unavailable";

    showSectionError("cms-projects", "Could not load projects.");
  }

  // STORE PRODUCTS
  try {
    const { data, error } = await db
      .from("products")
      .select("*")
      .eq("published", true)
      .order("created_at", { ascending: false });

    if (error) throw error;

    const products = data || [];
    const container = document.getElementById("cms-products");

    container.innerHTML = products.length
      ? products.map(product => {
          const image = safeUrl(product.image);
          const link = safeUrl(product.link_url);

          const content = `
            <div class="product-img">
              ${image
                ? `<img src="${escapeHtml(image)}"
                    alt="${escapeHtml(product.title || "")}"
                    loading="lazy">`
                : `<span class="ph">[ product image ]</span>`}
            </div>

            <div class="product-info">
              <div class="title">${escapeHtml(product.title || "Untitled product")}</div>

              ${product.description
                ? `<p class="meta">${escapeHtml(product.description)}</p>`
                : ""}

              ${product.price
                ? `<div class="meta">${escapeHtml(product.price)}</div>`
                : ""}

              ${link
                ? `<span class="product-link-label">View item ↗</span>`
                : ""}
            </div>`;

          return link
            ? `<a class="product" href="${escapeHtml(link)}"
                  target="_blank" rel="noopener noreferrer">${content}</a>`
            : `<article class="product">${content}</article>`;
        }).join("")
      : '<p class="meta">No published products yet.</p>';

  } catch (error) {
    console.error("Products:", error);

    showSectionError("cms-products", "Products could not be loaded.");
  }

  // OTHER CONTENT
  try {
    const { data, error } = await db
      .from("other_content")
      .select("*")
      .eq("published", true)
      .order("created_at", { ascending: false });

    if (error) throw error;

    const items = data || [];
    const container = document.getElementById("cms-other");

    container.innerHTML = items.length
      ? items.map(item => {
          const image = safeUrl(item.image);
          const link = safeUrl(item.link_url);

          const content = `
            ${image
              ? `<img src="${escapeHtml(image)}"
                  alt="${escapeHtml(item.title || "")}"
                  loading="lazy"
                  style="width:100%;height:100%;object-fit:cover;position:absolute;inset:0">`
              : `<span class="ph">${escapeHtml(item.type || "Photography")}</span>`}

            <div style="position:absolute;left:0;right:0;bottom:0;padding:12px;background:linear-gradient(transparent,rgba(0,0,0,.8));color:white">
              <div>${escapeHtml(item.title || "")}</div>
              ${item.caption
                ? `<div class="meta">${escapeHtml(item.caption)}</div>`
                : ""}
            </div>`;

          return link
            ? `<a class="tile" href="${escapeHtml(link)}"
                  target="_blank" rel="noopener noreferrer"
                  style="position:relative;overflow:hidden">${content}</a>`
            : `<article class="tile"
                  style="position:relative;overflow:hidden">${content}</article>`;
        }).join("")
      : '<p class="meta">No published content yet.</p>';

  } catch (error) {
    console.error("Other content:", error);

    showSectionError("cms-other", "Other content could not be loaded.");
  }

  // HOMEPAGE HERO REEL
  try {
    const { data, error } = await db
      .from("site_settings")
      .select("hero_video, hero_poster, hero_autoplay, hero_muted, hero_loop")
      .order("id", { ascending: true })
      .limit(1);

    if (error) throw error;

    const settings = data && data[0];
    const hero = document.getElementById("hero-media");

    if (settings && settings.hero_video && hero) {
      const videoUrl = safeUrl(settings.hero_video);

      if (!videoUrl) {
        throw new Error("The hero video URL is invalid.");
      }

      const video = document.createElement("video");

      video.src = videoUrl;
      video.autoplay = settings.hero_autoplay !== false;
      video.muted = settings.hero_muted !== false;
      video.loop = settings.hero_loop !== false;
      video.playsInline = true;
      video.controls = false;
      video.preload = "metadata";

      const posterUrl = safeUrl(settings.hero_poster);

      if (posterUrl) {
        video.poster = posterUrl;
      }

      hero.replaceChildren(video);

      if (video.autoplay) {
        video.play().catch(error => {
          console.warn("Hero autoplay was blocked:", error);
        });
      }
    }
  } catch (error) {
    console.error("Hero reel:", error);
  }
})();
</script>
