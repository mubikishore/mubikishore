
---
title: MUBIKISHORE
layout: base.njk
---
<section class="hero">
  <div class="hero-box">
    <div class="hero-copy">
      <div class="eyebrow">{{site.tagline}}</div>
      <h1>MUBI<br>KISHORE</h1>
      <div class="hero-media" id="hero-media"><span class="ph">[ hero still / reel ]</span></div>
    </div>
  </div>
  <div class="hero-meta meta">
    <span>{{site.location}}</span>
    <span>Selected works · 2024—2026</span>
    <span>Scroll ↓</span>
  </div>
</section>

<section class="section" id="work">
  <div class="head">
    <span>01 / Selected Work</span>
    <span id="project-count">Loading…</span>
  </div>
  <p class="intro">Films, collaborations, experiments and things made along the way.</p>
  <div class="work" id="cms-projects">
    <div class="row">
      <span class="meta">—</span>
      <span class="title">Loading projects…</span>
      <span class="meta date"></span>
      <span>→</span>
    </div>
  </div>
</section>

<section class="section" id="store">
  <div class="head">
    <span>02 / Store</span>
    <span>Objects / prints / editions</span>
  </div>
  <div class="grid store" id="cms-products">
    <p class="meta">Loading products…</p>
  </div>
</section>

<section class="section" id="other">
  <div class="head">
    <span>03 / Other Things</span>
    <span>35mm / BTS / photography / tests</span>
  </div>
  <div class="grid" id="cms-other">
    <p class="meta">Loading other things…</p>
  </div>
</section>

<section class="section" id="about">
  <div class="head">
    <span>04 / About</span>
    <span>Words later</span>
  </div>
  <div class="about">
    <div class="about-copy">{{site.about}}</div>
    <div class="about-side">
      {{site.location}}<br><br>
      Available for films / collaborations / commercial work<br><br>
      {{site.instagram}}<br>
      {{site.email}}
    </div>
  </div>
</section>

<footer>
  <span>MUBIKISHORE</span>
  <span>© 2026</span>
</footer>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="/admin/config.js"></script>

<style>
.hero-box{position:relative;overflow:hidden}
.hero-media{width:min(760px,90%);max-height:48vh;aspect-ratio:16/9;margin:26px auto 0;position:relative;overflow:hidden;background:#151515;display:flex;align-items:center;justify-content:center}
.hero-media video,.hero-media img,.hero-media iframe{width:100%;height:100%;object-fit:cover;border:0}
.hero-media .ph{position:absolute;z-index:1}
.product-img img,.tile img{width:100%;height:100%;object-fit:cover;display:block}
.tile{position:relative;overflow:hidden;display:block}
.tile-caption{position:absolute;left:12px;right:12px;bottom:12px;font:10px monospace;text-transform:uppercase;color:#fff;text-shadow:0 1px 8px #000}
.store .product .title{font-size:18px}
.store .product-info .meta{margin-top:8px}
.cms-empty{padding:24px;color:#777;font:11px monospace}
@media(max-width:700px){.hero-media{width:100%;max-height:36vh}}
</style>

<script>
(async function(){
  const client=window.MUBI_SUPABASE;
  const $=id=>document.getElementById(id);
  const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const empty=(id,msg)=>{const el=$(id);if(el)el.innerHTML='<p class="cms-empty">'+esc(msg)+'</p>';};

  if(!client){
    empty('cms-projects','Projects are temporarily unavailable.');
    empty('cms-products','Store is temporarily unavailable.');
    empty('cms-other','Other content is temporarily unavailable.');
    return;
  }

  async function loadProjects(){
    try{
      const {data,error}=await client.from('projects')
        .select('title,slug,date,year,published')
        .eq('published',true)
        .order('date',{ascending:false,nullsFirst:false});
      if(error)throw error;
      $('project-count').textContent=(data||[]).length+' projects';
      if(!data?.length){empty('cms-projects','No published projects yet.');return;}
      $('cms-projects').innerHTML=data.map(p=>{
        const date=p.date?new Date(p.date+'T00:00:00').toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'}):'';
        return `<a class="row" href="/project.html?slug=${encodeURIComponent(p.slug||'')}">
          <span class="meta">${esc(p.year||'')}</span>
          <span class="title">${esc(p.title||'Untitled project')}</span>
          <span class="meta date">${esc(date)}</span><span>→</span></a>`;
      }).join('');
    }catch(e){console.error('Projects:',e);empty('cms-projects','Projects could not be loaded.');}
  }

  async function loadProducts(){
    try{
      const {data,error}=await client.from('products').select('*')
        .eq('published',true).order('created_at',{ascending:false});
      if(error)throw error;
      if(!data?.length){empty('cms-products','No products available yet.');return;}
      $('cms-products').innerHTML=data.map(p=>{
        const image=p.image||p.image_url||p.image_path||'';
        const price=p.price!==null&&p.price!==undefined&&p.price!==''
          ?(String(p.price).startsWith('₹')?p.price:'₹'+p.price):'';
        return `<article class="product">
          <div class="product-img">${image?`<img src="${esc(image)}" alt="${esc(p.title||'Product')}" loading="lazy">`:'<span class="ph">[ product image ]</span>'}</div>
          <div class="product-info"><div class="title">${esc(p.title||'Untitled product')}</div>
          <div class="meta">${esc(price)}</div>
          ${p.description?`<p class="meta">${esc(p.description)}</p>`:''}</div>
        </article>`;
      }).join('');
    }catch(e){console.error('Products:',e);empty('cms-products','Products could not be loaded.');}
  }

  async function loadOther(){
    try{
      const {data,error}=await client.from('other_content').select('*')
        .eq('published',true).order('created_at',{ascending:false});
      if(error)throw error;
      if(!data?.length){empty('cms-other','No other content published yet.');return;}
      $('cms-other').innerHTML=data.map(p=>`
        <article class="tile">
          ${p.image?`<img src="${esc(p.image)}" alt="${esc(p.title||p.type||'Other content')}" loading="lazy">`:`<span class="ph">${esc(p.type||'Other')}</span>`}
          <div class="tile-caption">${esc(p.title||p.type||'')}${p.caption?' — '+esc(p.caption):''}</div>
        </article>`).join('');
    }catch(e){console.error('Other content:',e);empty('cms-other','Other content could not be loaded.');}
  }

  async function loadSettings(){
    try{
      const {data,error}=await client.from('site_settings').select('*').limit(1);
      if(error)throw error;
      const s=data?.[0];
      if(!s)return;

      const eyebrow=document.querySelector('.hero-copy .eyebrow');
      if(eyebrow&&s.tagline)eyebrow.textContent=s.tagline;

      const location=document.querySelector('.hero-meta span');
      if(location&&s.location)location.textContent=s.location;

      const about=document.querySelector('.about-copy');
      if(about&&s.about)about.textContent=s.about;

      const side=document.querySelector('.about-side');
      if(side){
        side.innerHTML=esc(s.location||'')+
          '<br><br>Available for films / collaborations / commercial work<br><br>'+
          (s.instagram?`<a href="${esc(s.instagram)}" target="_blank" rel="noopener">INSTAGRAM ↗</a>`:'')+
          '<br>'+(s.email?`<a href="mailto:${esc(s.email)}">${esc(s.email)}</a>`:'');
      }

      const media=$('hero-media');
      if(media&&s.hero_video){
        const video=s.hero_video.trim();
        if(/\.(mp4|webm)(\?.*)?$/i.test(video)){
          media.innerHTML=`<video src="${esc(video)}" autoplay muted loop playsinline controls></video>`;
        }else{
          const match=video.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|vimeo\.com\/)([\w-]+)/);
          if(match){
            const src=video.includes('vimeo')
              ?'https://player.vimeo.com/video/'+match[1]+'?autoplay=1&muted=1&loop=1'
              :'https://www.youtube-nocookie.com/embed/'+match[1]+'?autoplay=1&mute=1&loop=1&playlist='+match[1];
            media.innerHTML=`<iframe src="${src}" title="MUBIKISHORE hero reel" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>`;
          }else{
            media.innerHTML=`<a href="${esc(video)}" target="_blank" rel="noopener">WATCH HERO REEL ↗</a>`;
          }
        }
      }else if(media&&s.hero_image){
        media.innerHTML=`<img src="${esc(s.hero_image)}" alt="MUBIKISHORE hero still">`;
      }
    }catch(e){console.warn('Settings unavailable:',e.message);}
  }

  await Promise.all([loadProjects(),loadProducts(),loadOther(),loadSettings()]);
})();
</script>
