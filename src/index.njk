---
title: MUBIKISHORE
layout: base.njk
---
<section class="hero">
  <div class="hero-box">
    <div class="hero-copy">
      <div class="eyebrow">{{site.tagline}}</div>
      <h1>MUBI<br>KISHORE</h1>
      <div class="hero-media" id="hero-media">
        <span class="ph">[ hero still / reel ]</span>
      </div>
    </div>
  </div>
  <div class="hero-meta meta">
    <span>{{site.location}}</span>
    <span>Selected works · 2024—2026</span>
    <span>Scroll ↓</span>
  </div>
</section>

<section class="section" id="work">
  <div class="head">
    <span>01 / Selected Work</span>
    <span id="project-count">Loading…</span>
  </div>
  <p class="intro">Films, collaborations, experiments and things made along the way.</p>
  <div class="work" id="cms-projects">
    <div class="row">
      <span class="meta">—</span>
      <span class="title">Loading projects…</span>
      <span class="meta date"></span>
      <span>→</span>
    </div>
  </div>
</section>

<section class="section" id="store">
  <div class="head">
    <span>02 / Store</span>
    <span>Objects / prints / editions</span>
  </div>
  <div class="grid store" id="cms-products">
    <p class="meta">Loading products…</p>
  </div>
</section>

<section class="section" id="other">
  <div class="head">
    <span>03 / Other Things</span>
    <span>35mm / BTS / photography / tests</span>
  </div>
  <div class="grid" id="cms-other">
    <p class="meta">Loading other content…</p>
  </div>
</section>

<section class="section" id="about">
  <div class="head">
    <span>04 / About</span>
    <span>Words later</span>
  </div>
  <div class="about">
    <div class="about-copy">{{site.about}}</div>
    <div class="about-side">
      {{site.location}}<br><br>
      Available for films / collaborations / commercial work<br><br>
      {{site.instagram}}<br>
      {{site.email}}
    </div>
  </div>
</section>

<footer>
  <span>MUBIKISHORE</span>
  <span>© 2026</span>
</footer>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="/admin/config.js"></script>

<script>
(async function () {
  const db = window.MUBI_SUPABASE;

  const escapeHtml = value => String(value ?? "")
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");

  function safeImage(value) {
    if (!value) return "";
    try {
      const url = new URL(value, location.origin);
      return ["https:", "http:"].includes(url.protocol) ? url.href : "";
    } catch {
      return "";
    }
  }

  function safeLink(value) {
    if (!value) return "";
    try {
      const url = new URL(value, location.origin);
      return ["https:", "http:"].includes(url.protocol) ? url.href : "";
    } catch {
      return "";
    }
  }

  if (!db) {
    document.getElementById("project-count").textContent = "Content unavailable";
    document.getElementById("cms-projects").innerHTML =
      '<p class="meta">Unable to connect to the content database.</p>';
    document.getElementById("cms-products").innerHTML = "";
    document.getElementById("cms-other").innerHTML = "";
    return;
  }

  // SELECTED WORK
  try {
    const { data, error } = await db
      .from("projects")
      .select("title, slug, date, year, published")
      .eq("published", true)
      .order("date", { ascending: false, nullsFirst: false });

    if (error) throw error;

    const projects = data || [];
    document.getElementById("project-count").textContent =
      `${projects.length} projects`;

    document.getElementById("cms-projects").innerHTML = projects.length
      ? projects.map(project => {
          const date = project.date
            ? new Date(project.date + "T00:00:00").toLocaleDateString("en-GB", {
                day: "numeric",
                month: "long",
                year: "numeric"
              })
            : "";

          return `
            <a class="row" href="/project.html?slug=${encodeURIComponent(project.slug || "")}">
              <span class="meta">${escapeHtml(project.year || "")}</span>
              <span class="title">${escapeHtml(project.title || "Untitled project")}</span>
              <span class="meta date">${escapeHtml(date)}</span>
              <span>→</span>
            </a>`;
        }).join("")
      : `<div class="row">
          <span class="meta">—</span>
          <span class="title">No published projects yet.</span>
          <span></span><span>→</span>
        </div>`;
  } catch (error) {
    console.error("Projects:", error);
    document.getElementById("project-count").textContent = "Projects unavailable";
    document.getElementById("cms-projects").innerHTML =
      '<p class="meta">Could not load projects.</p>';
  }

  // STORE PRODUCTS — CLICKABLE WHEN A LINK IS PROVIDED
  try {
    const { data, error } = await db
      .from("products")
      .select("id, title, slug, price, description, image, link_url, published, created_at")
      .eq("published", true)
      .order("created_at", { ascending: false });

    if (error) throw error;

    const products = data || [];
    const container = document.getElementById("cms-products");

    container.innerHTML = products.length
      ? products.map(product => {
          const image = safeImage(product.image);
          const link = safeLink(product.link_url);

          const cardContent = `
            <div class="product-img">
              ${image
                ? `<img src="${escapeHtml(image)}"
                    alt="${escapeHtml(product.title)}"
                    loading="lazy"
                    style="width:100%;height:100%;object-fit:cover;display:block">`
                : '<span class="ph">[ product image ]</span>'}
            </div>
            <div class="product-info">
              <div class="title">${escapeHtml(product.title || "Untitled product")}</div>
              ${product.description
                ? `<p class="meta">${escapeHtml(product.description)}</p>`
                : ""}
              <div class="meta">${product.price
                ? `₹ ${escapeHtml(product.price)}`
                : ""}</div>
            </div>`;

          return link
            ? `<a class="product" href="${escapeHtml(link)}"
                  target="_blank" rel="noopener noreferrer"
                  aria-label="View ${escapeHtml(product.title)}">
                 ${cardContent}
               </a>`
            : `<article class="product">${cardContent}</article>`;
        }).join("")
      : '<p class="meta">No published products yet.</p>';

  } catch (error) {
    console.error("Products:", error);
    document.getElementById("cms-products").innerHTML =
      '<p class="meta">Products could not be loaded.</p>';
  }

  // OTHER CONTENT
  try {
    const { data, error } = await db
      .from("other_content")
      .select("id, title, type, caption, image, published, created_at")
      .eq("published", true)
      .order("created_at", { ascending: false });

    if (error) throw error;

    const items = data || [];
    const container = document.getElementById("cms-other");

    container.innerHTML = items.length
      ? items.map(item => {
          const image = safeImage(item.image);

          return `
            <article class="tile" style="position:relative;overflow:hidden">
              ${image
                ? `<img src="${escapeHtml(image)}"
                    alt="${escapeHtml(item.title)}"
                    loading="lazy"
                    style="width:100%;height:100%;object-fit:cover;position:absolute;inset:0">`
                : `<span class="ph">${escapeHtml(item.type || "Photography")}</span>`}
              <div style="position:absolute;left:0;right:0;bottom:0;padding:12px;background:linear-gradient(transparent,rgba(0,0,0,.8));color:white">
                <div>${escapeHtml(item.title)}</div>
                ${item.caption
                  ? `<div class="meta">${escapeHtml(item.caption)}</div>`
                  : ""}
              </div>
            </article>`;
        }).join("")
      : '<p class="meta">No published content yet.</p>';

  } catch (error) {
    console.error("Other content:", error);
    document.getElementById("cms-other").innerHTML =
      '<p class="meta">Other content could not be loaded.</p>';
  }
})();
</script>
