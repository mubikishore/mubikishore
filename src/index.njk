<section class="section" id="store">
  <div class="head">
    <span>02 / Store</span>
    <span>Objects / prints / editions</span>
  </div>

  <div class="grid store" id="cms-products">
    <p class="meta">Loading products…</p>
  </div>
</section>

<script>
(async function () {
  const store = document.getElementById("cms-products");
  if (!store || !window.MUBI_SUPABASE) return;

  function escapeHtml(value) {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  try {
    const { data, error } = await window.MUBI_SUPABASE
      .from("products")
      .select("*")
      .eq("published", true)
      .order("created_at", { ascending: false });

    if (error) throw error;

    if (!data || data.length === 0) {
      store.innerHTML = '<p class="meta">No products available yet.</p>';
      return;
    }

    store.innerHTML = data.map(product => {
      const image = product.image_url || product.image || product.image_path || "";
      const title = escapeHtml(product.title || product.name || "Untitled product");
      const price = product.price != null && product.price !== ""
        ? "₹" + escapeHtml(product.price)
        : "";

      return `
        <article class="product">
          <div class="product-img">
            ${image
              ? `<img src="${escapeHtml(image)}" alt="${title}" loading="lazy" style="width:100%;height:100%;object-fit:cover;">`
              : '<span class="ph">[ product image ]</span>'}
          </div>
          <div class="product-info">
            <div class="title">${title}</div>
            <div class="meta">${price}</div>
          </div>
        </article>`;
    }).join("");
  } catch (error) {
    console.error("Store loading error:", error);
    store.innerHTML =
      '<p class="meta">Unable to load products. Please try again later.</p>';
  }
})();
</script>
